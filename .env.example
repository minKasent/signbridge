# Copy thành .env và điền key thật (xem hướng dẫn lấy key: docs/SETUP-KEYS.md)
# .env đã nằm trong .gitignore — KHÔNG BAO GIỜ commit key thật.

# Google AI Studio — LLM ghép gloss thành câu tiếng Việt (miễn phí)
GEMINI_API_KEY=

# Weights & Biases — log thí nghiệm huấn luyện (miễn phí)
WANDB_API_KEY=

# HuggingFace — tải dataset VOYA_VSL (fallback) + model PhoWhisper
HF_TOKEN=

# Kaggle — GPU miễn phí + tải dataset (token dạng KGAT_...)
KAGGLE_API_TOKEN=

# --- Backend (chỉ cần khi triển khai thật, dev đã có giá trị mặc định) ---
# SIGNBRIDGE_SECURITY_JWT_SECRET=       # >= 32 byte ngẫu nhiên
# SIGNBRIDGE_SECURITY_ADMIN_EMAIL=
# SIGNBRIDGE_SECURITY_ADMIN_PASSWORD=
